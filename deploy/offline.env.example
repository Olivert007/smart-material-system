# Offline deployment environment (doc 21). Copy to deploy/offline.env and edit.
OPS_TOKEN=change-me-offline
MODELS_DIR=/models
LLM_BIG_MODEL=qwen3.6-27b
LLM_FAST_MODEL=qwen2.5-7b
LLM_EMBED_MODEL=qwen3-embedding-0.6b

# Pin vLLM image by digest (required for compose-offline). On a connected host:
#   ./scripts/resolve_vllm_image.sh v0.8.5 >> deploy/offline.env
# Or: docker pull vllm/vllm-openai:v0.8.5
#     docker inspect --format='{{index .RepoDigests 0}}' vllm/vllm-openai:v0.8.5
VLLM_IMAGE=vllm/vllm-openai:v0.8.5@sha256:REPLACE_ME
