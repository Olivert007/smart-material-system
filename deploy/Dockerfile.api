# API + in-process worker (F3). Offline builds use wheelhouse (doc 21 §7.1).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DATA_DIR=/app/data

ARG OFFLINE_BUILD=0

COPY requirements.txt requirements-lock.txt /app/
COPY offline/wheelhouse /wheelhouse

RUN if [ "$OFFLINE_BUILD" = "1" ]; then \
      pip install --no-index --find-links=/wheelhouse -r /app/requirements-lock.txt; \
    else \
      pip install --no-cache-dir -r /app/requirements.txt; \
    fi

COPY app /app/app
COPY scripts/init_data_volume.py scripts/run_intake_worker.py scripts/docker_entrypoint_api.sh /app/scripts/
COPY data/flow_config /app/data/flow_config
COPY data/flow_config /app/seed/flow_config

RUN chmod +x /app/scripts/docker_entrypoint_api.sh

EXPOSE 8010
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/health/live')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
