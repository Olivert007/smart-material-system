# API + in-process worker (F3). Writer is same process via unique lock.
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DATA_DIR=/app/data

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY app /app/app
COPY scripts/init_data_volume.py scripts/run_intake_worker.py scripts/docker_entrypoint_api.sh /app/scripts/
COPY data/flow_config /app/data/flow_config
COPY data/flow_config /app/seed/flow_config

RUN chmod +x /app/scripts/docker_entrypoint_api.sh

EXPOSE 8010
HEALTHCHECK --interval=10s --timeout=5s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/health/live')"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
