# Runtime data (never commit live DB / uploads)
data/uploads/
data/raw_evidence/
data/staging/
data/backups/
data/reports/
data/eval/
data/test_run/
data/*.sqlite
data/*.sqlite.*
data/*.sqlite-wal
data/*.sqlite-shm
data/*.duckdb
data/*.duckdb.*

# Demo: runtime + local-only samples (涉密样例不入库)
demo_data/runtime/
demo_data/demo_stats.json
demo_data/samples/*
!demo_data/samples/.gitkeep

# Test sandboxes (scripts recreate under tests/sandboxes/)
tests/sandboxes/**
!tests/sandboxes/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
dist/
build/

# Frontend
frontend/node_modules/
frontend/dist/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local secrets
.env
.env.*
!.env.example
deploy/.env

# Offline build artifacts (regenerate via scripts/prepare_offline_bundle.py)
offline/wheelhouse/*
offline/npm-cache/*
!offline/wheelhouse/.gitkeep
!offline/npm-cache/.gitkeep
